{
  "name": "@mk/film",
  "version": "1.0.0-alpha",
  "description": "Film — an opinionated Lit web component library built on modular scale and every-layout primitives",
  "type": "module",
  "main": "./dist/film.js",
  "module": "./dist/film.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/film.js"
    },
    "./css/*": "./css/*"
  },
  "files": [
    "dist",
    "css",
    "src",
    "custom-elements.json"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/**/*.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "analyze": "cem analyze",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,css,md,json}\"",
    "test": "wtr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emkay/film.git"
  },
  "keywords": [
    "lit",
    "web-components",
    "every-layout",
    "modular-scale",
    "design-system"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/emkay/film/issues"
  },
  "homepage": "https://github.com/emkay/film#readme",
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@open-wc/testing": "^5.0.0",
    "@types/node": "^22.20.1",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0"
  },
  "customElements": "custom-elements.json"
}
