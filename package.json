{
  "name": "@mk/film",
  "version": "1.0.0-alpha",
  "description": "Film — an opinionated Lit web component library built on modular scale and every-layout primitives",
  "type": "module",
  "main": "./dist/film.js",
  "module": "./dist/film.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/film.js"
    },
    "./css/*": "./css/*"
  },
  "files": [
    "dist",
    "css",
    "src"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/**/*.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emkay/film.git"
  },
  "keywords": [
    "lit",
    "web-components",
    "every-layout",
    "modular-scale",
    "design-system"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/emkay/film/issues"
  },
  "homepage": "https://github.com/emkay/film#readme",
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0"
  }
}
