{
  "name": "@mk/film",
  "version": "1.2.3",
  "description": "Film — an opinionated Lit web component library built on modular scale and every-layout primitives",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./css/*": "./css/*",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "css",
    "src",
    "custom-elements.json"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/**/*.ts",
    "./dist/**/*.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "analyze": "cem analyze && node scripts/sort-manifest.mjs",
    "gen:react": "node scripts/gen-react.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,css,md,json}\"",
    "test": "wtr",
    "prepublishOnly": "rm -rf dist && npm run build:lib && npm run check:dist && npm run check:bundle"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emkay/film.git"
  },
  "keywords": [
    "lit",
    "web-components",
    "every-layout",
    "modular-scale",
    "design-system"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/emkay/film/issues"
  },
  "homepage": "https://github.com/emkay/film#readme",
  "dependencies": {
    "lit": "^3.2.1",
    "@lit/react": "^1.0.8"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@lit/react": "^1.0.8",
    "@open-wc/testing": "^5.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0"
  },
  "customElements": "custom-elements.json"
}
